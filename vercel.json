{
  "version": 2,
  "builds": [
    {
      "src": "docs/conf.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "docs/_build/html/$1"
    }
  ],
  "buildCommand": "pip install -r requirements.txt && sphinx-build -b html docs docs/_build/html",
  "outputDirectory": "docs/_build/html",
  "framework": null
}
